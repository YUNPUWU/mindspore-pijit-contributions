From 63863e71c8f6205c3e9ee5ce45762f504cc27aca Mon Sep 17 00:00:00 2001
From: w30010434 <wuyunpu1@huawei.com>
Date: Sat, 25 Nov 2023 16:54:16 +0800
Subject: [PATCH] support tuple type derive

---
 .../jit/pi/graph_capture/abstract_object.cc   | 29 ++++++++++++++++---
 1 file changed, 25 insertions(+), 4 deletions(-)

diff --git a/mindspore/ccsrc/pipeline/jit/pi/graph_capture/abstract_object.cc b/mindspore/ccsrc/pipeline/jit/pi/graph_capture/abstract_object.cc
index 84f7e8046..45c3f4e16 100644
--- a/mindspore/ccsrc/pipeline/jit/pi/graph_capture/abstract_object.cc
+++ b/mindspore/ccsrc/pipeline/jit/pi/graph_capture/abstract_object.cc
@@ -992,11 +992,32 @@ AObject *AbstractTuple::GetItem(AObject *k) {
   if (!IsElementValid()) {
     return AObject::MakeAObject(element_type_);
   }
-  Py_ssize_t index = GetTupleIndex(k, this->size());
-  if (index == -1) {
-    return AObject::MakeAObject(kTypeAnyValue);
+  AObject *resultTuple = AObject::MakeAObject(kTypeTuple);
+  if (k->GetType() == AObject::kTypeSlice) {
+    PyObject *slicePyObject = k->GetPyObject().ptr();
+
+    Py_ssize_t start, stop, step;
+    if (PySlice_Unpack(slicePyObject, &start, &stop, &step) < 0) {
+      return nullptr;
+    }
+    if (start >= stop) {
+      return resultTuple;
+    }
+    AbstractTuple *resultTuplePtr = static_cast<AbstractTuple *>(resultTuple);
+    if (start == 0 && step == 1) {
+      resultTuplePtr->Update(this->items());
+      return resultTuplePtr;
+    } else if (step > 1) {
+      int cursor = 0;
+      std::vector<AObject *> itemsVector;
+      for (cursor = 0; cursor < stop; cursor += step) {
+        itemsVector.push_back(this->items()[cursor]);
+      }
+      resultTuplePtr->Update(itemsVector);
+    }
+    return resultTuplePtr;
   }
-  return items_[index];
+  return resultTuple;
 }
 
 #undef GET_INDEX
